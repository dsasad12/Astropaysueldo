# ─── Credenciales AstroPay ────────────────────────────────────────────────────
ASTROPAY_EMAIL=tu_email@ejemplo.com
ASTROPAY_PASSWORD=tu_contraseña

# ─── Tarjeta a usar ───────────────────────────────────────────────────────────
# Últimos 4 dígitos de tu Visa Débito Banco Provincia (para identificarla)
CARD_LAST4=9009

# ─── Monto a depositar (en ARS) ───────────────────────────────────────────────
DEPOSIT_AMOUNT=150000

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_FILE=astropay_salary.log
LOG_LEVEL=INFO
