# ─── Credenciales AstroPay Merchant ───────────────────────────────────────────
ASTROPAY_MERCHANT_ID=tu_merchant_id_aqui
ASTROPAY_API_KEY=tu_api_key_aqui
ASTROPAY_SECRET_KEY=tu_secret_key_aqui

# ─── Configuración de la tarjeta ──────────────────────────────────────────────
# Número de tarjeta Visa Débito Banco Provincia (sin espacios)
CARD_NUMBER=4000000000000000
# Mes de vencimiento (MM)
CARD_EXPIRY_MONTH=12
# Año de vencimiento (YY)
CARD_EXPIRY_YEAR=28
# CVV / CVC
CARD_CVV=123
# Nombre tal como aparece en la tarjeta
CARD_HOLDER_NAME=NOMBRE APELLIDO

# ─── Configuración del depósito ───────────────────────────────────────────────
# Monto a depositar en ARS (si DEPOSIT_FULL_BALANCE=true se usa como fallback)
DEPOSIT_AMOUNT=0
# Moneda (ARS para pesos argentinos)
DEPOSIT_CURRENCY=ARS
# Si es true, intenta depositar el saldo completo disponible en Banco Provincia
# Si es false, usa el monto fijo en DEPOSIT_AMOUNT
DEPOSIT_FULL_BALANCE=false

# ─── Notificaciones (opcional) ────────────────────────────────────────────────
# Email para recibir confirmación (dejar vacío para deshabilitar)
NOTIFICATION_EMAIL=
# URL de webhook para notificación (dejar vacío para deshabilitar)
NOTIFICATION_WEBHOOK_URL=

# ─── Ambiente ─────────────────────────────────────────────────────────────────
# sandbox  → usa el entorno de pruebas de AstroPay
# production → usa el entorno real
ASTROPAY_ENV=sandbox

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_FILE=astropay_salary.log
LOG_LEVEL=INFO
